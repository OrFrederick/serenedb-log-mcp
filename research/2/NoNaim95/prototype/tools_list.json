[
 {
  "name": "describe_corpus",
  "description": "Describe the Base Corpus: per Dataset (bgl, openstack) the number of Log Entries, first/last timestamp,\n    and Log Entry counts per Component and per level. Call this first to learn valid filter values and time ranges.\n    No inputs. Output: one row per Dataset plus Evidence.",
  "inputSchema": {
   "type": "object",
   "properties": {},
   "title": "describe_corpusArguments"
  },
  "outputSchema": {
   "$defs": {
    "DataScope": {
     "properties": {
      "datasets": {
       "items": {
        "type": "string"
       },
       "title": "Datasets",
       "type": "array"
      },
      "time_from": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Time From"
      },
      "time_to": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Time To"
      },
      "filters": {
       "additionalProperties": true,
       "title": "Filters",
       "type": "object"
      }
     },
     "required": [
      "datasets"
     ],
     "title": "DataScope",
     "type": "object"
    },
    "DatasetInfo": {
     "properties": {
      "dataset": {
       "title": "Dataset",
       "type": "string"
      },
      "entries": {
       "title": "Entries",
       "type": "integer"
      },
      "time_from": {
       "title": "Time From",
       "type": "string"
      },
      "time_to": {
       "title": "Time To",
       "type": "string"
      },
      "components": {
       "additionalProperties": {
        "type": "integer"
       },
       "title": "Components",
       "type": "object"
      },
      "levels": {
       "additionalProperties": {
        "type": "integer"
       },
       "title": "Levels",
       "type": "object"
      }
     },
     "required": [
      "dataset",
      "entries",
      "time_from",
      "time_to",
      "components",
      "levels"
     ],
     "title": "DatasetInfo",
     "type": "object"
    },
    "Evidence": {
     "properties": {
      "evidence_id": {
       "description": "Cite as [E<n>] next to every number taken from this result",
       "title": "Evidence Id",
       "type": "string"
      },
      "tool": {
       "title": "Tool",
       "type": "string"
      },
      "sql": {
       "description": "Executed SQL statements (parameter placeholders shown as %s)",
       "items": {
        "type": "string"
       },
       "title": "Sql",
       "type": "array"
      },
      "params": {
       "items": {
        "items": {},
        "type": "array"
       },
       "title": "Params",
       "type": "array"
      },
      "data_scope": {
       "$ref": "#/$defs/DataScope"
      },
      "total_count": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "description": "Exact number of matching Log Entries (or groups) in the Data Scope",
       "title": "Total Count"
      },
      "returned_count": {
       "title": "Returned Count",
       "type": "integer"
      },
      "truncated": {
       "description": "True when returned_count < total_count",
       "title": "Truncated",
       "type": "boolean"
      },
      "query_ms": {
       "title": "Query Ms",
