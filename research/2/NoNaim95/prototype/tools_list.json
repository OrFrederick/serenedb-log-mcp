       "title": "Line No",
       "type": "integer"
      },
      "ts": {
       "title": "Ts",
       "type": "string"
      },
      "source": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "BGL node or OpenStack source file",
       "title": "Source"
      },
      "component": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Component"
      },
      "level": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Level"
      },
      "message": {
       "description": "Message text, highlighted with **term** when from a search, capped at 240 chars",
       "title": "Message",
       "type": "string"
      },
      "score": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
