      },
      "instance_id": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Instance Id"
      },
      "alert_tag": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Alert Tag"
      },
      "is_anchor": {
       "default": false,
       "title": "Is Anchor",
       "type": "boolean"
      }
     },
     "required": [
      "dataset",
      "line_no",
      "ts",
      "source",
      "component",
      "level",
      "message"
