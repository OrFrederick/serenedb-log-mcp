     "title": "DataScope",
     "type": "object"
    },
    "Evidence": {
     "properties": {
      "evidence_id": {
       "description": "Cite as [E<n>] next to every number taken from this result",
       "title": "Evidence Id",
       "type": "string"
      },
      "tool": {
       "title": "Tool",
       "type": "string"
      },
      "sql": {
       "description": "Executed SQL statements (parameter placeholders shown as %s)",
       "items": {
        "type": "string"
       },
       "title": "Sql",
       "type": "array"
      },
      "params": {
       "items": {
        "items": {},
        "type": "array"
       },
       "title": "Params",
       "type": "array"
      },
      "data_scope": {
       "$ref": "#/$defs/DataScope"
      },
      "total_count": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "description": "Exact number of matching Log Entries (or groups) in the Data Scope",
       "title": "Total Count"
