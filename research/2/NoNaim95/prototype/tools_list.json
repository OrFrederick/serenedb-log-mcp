 {
  "name": "search_logs",
  "description": "Full-text search of Log Entries (BM25 ranking, phrase, fuzzy) with time, Component, level and source filters.\n    Returns at most `limit` entries with highlighted messages plus the EXACT total number of matching entries,\n    so `truncated` tells you whether you saw everything. Use count_by/trend, not this, to say how often something\n    happens. Next: get_context(dataset, line_no) on an interesting entry.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "query": {
     "description": "Words to find in the message, e.g. 'ciod failed'",
     "title": "Query",
     "type": "string"
    },
    "dataset": {
     "default": "bgl",
     "enum": [
      "bgl",
      "openstack"
     ],
     "title": "Dataset",
     "type": "string"
    },
    "mode": {
     "default": "all_words",
     "description": "all_words (default): every word must appear; any_words: at least one; phrase: exact word sequence; fuzzy: each word within edit distance 1 (typos); web: websearch syntax with \"quoted phrases\", OR and -exclusions",
     "enum": [
      "all_words",
      "any_words",
      "phrase",
      "fuzzy",
      "web"
     ],
     "title": "Mode",
     "type": "string"
    },
    "time_from": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "ISO start, inclusive",
     "title": "Time From"
    },
    "time_to": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "ISO end, exclusive",
     "title": "Time To"
    },
    "components": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Exact Component names from describe_corpus",
     "title": "Components"
    },
    "levels": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Exact levels, e.g. ['FATAL','ERROR']",
     "title": "Levels"
    },
    "sources": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "BGL node ids or OpenStack source files",
     "title": "Sources"
    },
    "order": {
     "default": "relevance",
     "enum": [
      "relevance",
      "newest",
      "oldest"
     ],
     "title": "Order",
     "type": "string"
    },
    "limit": {
     "default": 20,
     "maximum": 50,
     "minimum": 1,
     "title": "Limit",
     "type": "integer"
    }
   },
   "required": [
    "query"
   ],
   "title": "search_logsArguments"
  },
  "outputSchema": {
   "$defs": {
    "DataScope": {
     "properties": {
      "datasets": {
       "items": {
        "type": "string"
       },
       "title": "Datasets",
       "type": "array"
      },
      "time_from": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Time From"
      },
      "time_to": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Time To"
      },
      "filters": {
       "additionalProperties": true,
       "title": "Filters",
       "type": "object"
      }
     },
     "required": [
      "datasets"
