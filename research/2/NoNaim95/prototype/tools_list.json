 {
  "name": "get_context",
  "description": "Log Entries just before and after one anchor entry, in time order: on the same node/source, the same\n    OpenStack request or instance, or across all sources in a time window. Use it to see what happened around a\n    failure. Output: entries (anchor flagged is_anchor) plus Evidence; total_count is the number of entries in\n    the context scope, so truncated shows whether the window holds more.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "dataset": {
     "enum": [
      "bgl",
      "openstack"
     ],
     "title": "Dataset",
     "type": "string"
    },
    "line_no": {
     "description": "line_no of the anchor Log Entry (from search_logs)",
     "title": "Line No",
     "type": "integer"
    },
    "scope": {
     "default": "same_source",
     "description": "same_source: same BGL node / OpenStack file; same_request / same_instance: OpenStack only; time_window: all sources within +/- window_seconds",
     "enum": [
      "same_source",
      "same_request",
      "same_instance",
      "time_window"
     ],
     "title": "Scope",
     "type": "string"
    },
    "before": {
     "default": 10,
     "maximum": 50,
     "minimum": 0,
     "title": "Before",
     "type": "integer"
    },
    "after": {
     "default": 10,
     "maximum": 50,
     "minimum": 0,
     "title": "After",
     "type": "integer"
    },
    "window_seconds": {
     "default": 60,
     "maximum": 3600,
     "minimum": 1,
     "title": "Window Seconds",
     "type": "integer"
    }
   },
   "required": [
    "dataset",
    "line_no"
   ],
   "title": "get_contextArguments"
