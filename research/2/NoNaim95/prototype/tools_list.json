       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Time From"
      },
      "time_to": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Time To"
      },
      "filters": {
       "additionalProperties": true,
       "title": "Filters",
       "type": "object"
